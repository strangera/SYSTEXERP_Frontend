{
  // 隱藏部分禁止修改
  "files.exclude": {
    "src/serve.json": true,
    "eslint.config.js": true,
    ".editorconfig": true,
    ".angulardoc.json": true,
    ".prettierrc": true,
    "package-lock.json": true,
    "deploy_TSRD_前端.bat": true,
    "deploy_TSRDdev_前端.bat": true,
    ".gitignore": true,
    "node_modules/": true,
    ".angular/": true,
    "CLAUDE.md": true,
    "src/favicon.ico": true,
    "src/index.html": true,
    "src/main.ts": true,
    "tsconfig.app.json": true,
    "tsconfig.spec.json": true,
    "tsconfig.json": true,
    "instructions.md": true,
    ".eslintrc.json": true,
    "sonar-project.properties": true,
    "ngsw-config.json": true,
    // "src/assets": true,
    ".sonarlint": true,
    ".scannerwork": true,
    "public": true,
    ".vscode/extensions.json": true,
    ".vscode/launch.json": true,
    ".vscode/tasks.json": true,
    "src/app/core": true,
    "src/styles.scss": true
  },
  // "html.format.wrapAttributes": "auto",
  "editor.formatOnSave": true, // 設置自動格式化
  "editor.defaultFormatter": "esbenp.prettier-vscode", // 使用 Prettier 格式化
  "prettier.singleQuote": true, // 使用單引號
  "prettier.printWidth": 80, // 設定每行最大字符數
  "prettier.tabWidth": 2, // 設定縮排寬度
  "prettier.useTabs": false,
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  // 設置 Live Server 的網站根目錄
  "liveServer.settings.root": "dist/tsrderp-frontend/browser",
  // 可選：當檔案儲存時是否自動重新載入
  "liveServer.settings.reloadBrowserWhenSaved": true,
  "sonarlint.connectedMode.project": {
    "connectionId": "http-127-0-0-1-9000-",
    "projectKey": "TSRDERP"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.bracketPairColorization.enabled": true,
  "javascript.suggest.paths": true,
  "typescript.suggest.paths": true,
  "html.suggest.paths": true,
  "typescript.referencesCodeLens.enabled": false
}