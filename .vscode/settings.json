{
  // 隱藏部分禁止修改
  "files.exclude": {
    ".prettierrc": true,
    "tsconfig.app.json": true,
    "tsconfig.json": true,
    "tsconfig.spec.json": true,
    ".editorconfig": true,
    "eslint.config.js": true,
    "post-build.js": true,
    "pre-build.js": true,
    "node_modules": true,
    ".sonarlint": true,
    ".vscode/extensions.json": true,
    ".vscode/launch.json": true,
    ".vscode/tasks.json": true,
    "sonar-project.properties": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true
  },
  "files.watcherExclude": {
    "**/node_modules/*/**": true,
    "**/dist/**": true
  },
  // "html.format.wrapAttributes": "auto",
  "editor.formatOnSave": true, // 設置自動格式化
  "editor.defaultFormatter": "esbenp.prettier-vscode", // 使用 Prettier 格式化
  "prettier.singleQuote": true, // 使用單引號
  "prettier.printWidth": 80, // 設定每行最大字符數
  "prettier.tabWidth": 2, // 設定縮排寬度
  "prettier.useTabs": false,
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  // 設置 Live Server 的網站根目錄
  "liveServer.settings.root": "dist/tsrderp-frontend/browser",
  // 可選：當檔案儲存時是否自動重新載入
  "liveServer.settings.reloadBrowserWhenSaved": true,
  "sonarlint.connectedMode.project": {
    "connectionId": "http-172-20-10-2-9000-",
    "projectKey": "TSRDERP_Frontend_Angular"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.bracketPairColorization.enabled": true,
  "js.suggest.paths": true,
  "ts.suggest.paths": true,
  "html.suggest.paths": true
}
