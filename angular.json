{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "TSRDERP_Frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "none",
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/tsrderp-frontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js", "@angular/localize/init"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/serve.json",
              "src/web.config.template",
              {
                "glob": "**/*",
                "input": "node_modules/@novnc/novnc",
                "output": "assets/novnc"
              }
            ],
            "styles": [
              "node_modules/primeng/resources/primeng.min.css",
              "node_modules/primeicons/primeicons.css",
              "node_modules/primeflex/primeflex.css",
              "src/assets/layout/layout.scss",
              "src/styles.scss",
              {
                "input": "src/assets/themes/lara-light-blue/lara-light-blue.scss",
                "inject": false,
                "bundleName": "lara-light-blue"
              },
              {
                "input": "src/assets/themes/lara-dark-blue/lara-dark-blue.scss",
                "inject": false,
                "bundleName": "lara-dark-blue"
              }
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                }
              ],
              "outputHashing": "all",
              "optimization": true,
              "assets": [
                "src/web.config",
                "src/favicon.ico",
                "src/assets",
                "src/serve.json",
                {
                  "glob": "**/*",
                  "input": "node_modules/@novnc/novnc",
                  "output": "assets/novnc"
                }
              ]
            },
            "tsrdweb": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "optimization": true,
              "sourceMap": false,
              "baseHref": "/TSRDWEB/",
              "assets": [
                "src/favicon.ico",
                "src/assets",
                "src/serve.json",
                "src/web.config.template",
                {
                  "glob": "**/*",
                  "input": "node_modules/@novnc/novnc",
                  "output": "assets/novnc"
                }
              ]
            },
            "tsrdweb-systex": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.systex.ts"
                }
              ],
              "outputHashing": "all",
              "optimization": true,
              "baseHref": "/SYSTEXWEB/",
              "assets": [
                "src/favicon.ico",
                "src/systex-favicon.ico",
                "src/assets",
                "src/serve.json",
                "src/web.config.template",
                {
                  "glob": "**/*",
                  "input": "node_modules/@novnc/novnc",
                  "output": "assets/novnc"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "leo": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/app/app.routes.ts",
                  "with": "src/app/app.routes.leo.ts"
                },
                {
                  "replace": "src/app/pages/pages.routes.ts",
                  "with": "src/app/pages/pages.routes.leo.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "TSRDERP_Frontend:build:production"
            },
            "development": {
              "buildTarget": "TSRDERP_Frontend:build:development"
            },
            "leo": {
              "buildTarget": "TSRDERP_Frontend:build:leo"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "hmr": true
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": ["src/styles.scss"],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "9201dc9f-2ce4-4001-9a32-a5c87bf84c77",
    "cache": {
      "enabled": true,
      "path": ".angular/cache",
      "environment": "all"
    }
  }
}
