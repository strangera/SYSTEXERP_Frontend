{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "i18n-translations",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/i18n/*.json"]
      },
      "cacheQueryOptions": {
        "ignoreSearch": true
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-config-data",
      "urls": ["/api/v1/config", "/api/v1/user-info"],
      "cacheConfig": {
        "maxSize": 5,
        "maxAge": "1d",
        "strategy": "performance"
      }
    }
  ]
}
