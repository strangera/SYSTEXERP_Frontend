{
  "name": "tsrderp-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node --max-old-space-size=8192 node_modules/@angular/cli/bin/ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:TSRDERP_Frontend": "node dist/tsrderp-frontend/server/server.mjs",
    "analyze": "source-map-explorer dist/**/*.js",
    "prebuild:version": "node pre-build.js",
    "build:tsrdweb": "npm run prebuild:version && ng build --configuration tsrdweb && node post-build.js tsrdweb /TSRDWEB/ && git checkout src/environments/*.ts",
    "build:systex": "npm run prebuild:version && ng build --configuration tsrdweb-systex && node post-build.js tsrdweb-systex /SYSTEXWEB/ && git checkout src/environments/*.ts",
    "sonar": "dotenv -- npx sonar-scanner -Dsonar.token=%SONAR_TOKEN%",
    "clean:imports": "npx organize-imports-cli \"src/app/pages/**/*.ts\"",
    "sync:sys1000": "node scripts/sync-sys1000.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.1.0",
    "@angular/cdk": "^18.1.1",
    "@angular/common": "^18.1.0",
    "@angular/compiler": "^18.1.0",
    "@angular/core": "^18.1.0",
    "@angular/forms": "^18.1.0",
    "@angular/platform-browser": "^18.1.0",
    "@angular/platform-browser-dynamic": "^18.1.0",
    "@angular/router": "^18.1.0",
    "@angular/ssr": "^18.1.1",
    "@auth0/angular-jwt": "^5.2.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@microsoft/signalr": "^10.0.0",
    "@ngneat/until-destroy": "^10.0.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@novnc/novnc": "^1.7.0",
    "chart.js": "^4.5.1",
    "crypto-js": "^4.2.0",
    "file-saver": "^2.0.5",
    "js-base64": "^3.7.7",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "jszip": "^3.10.1",
    "ngx-logger": "^5.0.12",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primeng": "^17.18.15",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.1.0",
    "xlsx-js-style": "^1.2.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.1.1",
    "@angular/cli": "^18.1.1",
    "@angular/compiler-cli": "^18.1.0",
    "@angular/localize": "^18.1.1",
    "@types/crypto-js": "^4.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.0",
    "@types/js-base64": "^3.0.0",
    "@types/jszip": "^3.4.0",
    "@types/range-parser": "^1.2.7",
    "@types/send": "^1.2.1",
    "@types/xlsx": "^0.0.35",
    "angular-eslint": "19.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.15.0",
    "eslint-formatter-visualstudio": "^8.40.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "3.3.0",
    "source-map-explorer": "^2.5.3",
    "typescript": "~5.5.2",
    "typescript-eslint": "8.16.0"
  }
}
