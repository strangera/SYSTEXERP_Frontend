/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "dom"
    ],
    "incremental": true,
    "baseUrl": "./",
    "paths": {
      "@pages/ass/*": [
        "src/app/pages/ass/*"
      ],
      "@pages/base/*": [
        "src/app/pages/base/*"
      ],
      "@pages/cpm/*": [
        "src/app/pages/cpm/*"
      ],
      "@pages/fin/*": [
        "src/app/pages/fin/*"
      ],
      "@pages/sys/*": [
        "src/app/pages/sys/*"
      ],
      "@pages/tls/*": [
        "src/app/pages/tls/*"
      ],
      "@guards/*": [
        "src/app/guards/*"
      ],
      "@interceptors/*": [
        "src/app/interceptors/*"
      ],
      "@service/*": [
        "src/app/service/*"
      ],
      "@shared/*": [
        "src/app/shared/*"
      ],
      "@componentkit/*": [
        "src/app/shared/componentkit/*"
      ],
      "@utils/*": [
        "src/app/utils/*"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}